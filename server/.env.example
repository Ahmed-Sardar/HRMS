# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api

# Database
MONGO_URI=mongodb://127.0.0.1:27017/hrms

# Auth
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d

# Client
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Mail (optional - logged to console when disabled)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="HRMS <no-reply@hrms.local>"

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Security
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300

# Background automation (leave balances, reminders, attendance)
# Set to true to stop the in-process scheduler entirely (manual runs still work).
DISABLE_AUTOMATION=false
# Auto-absent marking writes attendance records, so it is manual unless enabled.
ENABLE_AUTO_ABSENT=false
